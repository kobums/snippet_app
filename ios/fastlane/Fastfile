default_platform(:ios)

# App Store Connect API Key 인증 (비밀번호 입력 없이 자동화)
# 키 파일은 app/ios/AuthKey_XXXXXXXX.p8 에 위치
def api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],           # App Store Connect API Key ID
    issuer_id: ENV["ASC_ISSUER_ID"],     # Issuer ID
    key_filepath: ENV["ASC_KEY_PATH"],   # .p8 파일 경로
    duration: 1200,
    in_house: false
  )
end

platform :ios do

  # ---------------------------------------------------------
  # TestFlight 배포 (내부 테스트)
  # 사용법: cd app/ios && fastlane beta
  # ---------------------------------------------------------
  desc "TestFlight에 빌드 업로드"
  lane :beta do
    # 1. Flutter 빌드
    Dir.chdir("../..") do
      sh("export PATH=\"/opt/homebrew/bin:$PATH\" && flutter build ipa --release")
    end

    # 2. TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path("../../build/ios/ipa/Snippet.ipa", __dir__),
      skip_waiting_for_build_processing: true
    )

    puts "✅ TestFlight 업로드 완료!"
  end

  # ---------------------------------------------------------
  # App Store 심사 제출 (patch 버전 자동 증가)
  # 사용법: cd app/ios && fastlane release
  # ---------------------------------------------------------
  desc "patch 버전 bump 후 App Store 업로드"
  lane :release do
    # pubspec.yaml에서 현재 버전/빌드 번호 읽기
    pubspec = File.read("../../pubspec.yaml")
    version_line = pubspec.match(/^version:\s*(.+)$/)&.[](1)&.strip
    version_name, build_number = version_line&.split("+")
    parts = version_name.split(".")
    new_version = "#{parts[0]}.#{parts[1]}.#{parts[2].to_i + 1}"
    new_build = (build_number.to_i + 1).to_s

    # pubspec.yaml 버전 증가
    new_pubspec = pubspec.gsub(
      /^version:\s*.+$/,
      "version: #{new_version}+#{new_build}"
    )
    File.write("../../pubspec.yaml", new_pubspec)

    puts "📦 버전: #{new_version}+#{new_build}"

    # Flutter 빌드
    Dir.chdir("../..") do
      sh("export PATH=\"/opt/homebrew/bin:$PATH\" && flutter build ipa --release --build-number=#{new_build}")
    end

    # changelogs/{version}.txt → metadata/ko/release_notes.txt 복사
    changelog_path = File.expand_path("../../fastlane/changelogs/#{new_version}.txt", __dir__)
    UI.user_error!("릴리즈 노트가 없습니다. app/fastlane/changelogs/#{new_version}.txt를 작성하세요.") unless File.exist?(changelog_path)
    notes = File.read(changelog_path).strip
    UI.user_error!("changelogs/#{new_version}.txt가 비어있습니다.") if notes.empty?

    require 'fileutils'
    meta_path = File.expand_path("metadata", __dir__)
    FileUtils.mkdir_p("#{meta_path}/ko")
    File.write("#{meta_path}/ko/release_notes.txt", notes)

    # App Store 업로드 (심사 제출은 App Store Connect에서 수동으로)
    upload_to_app_store(
      api_key: api_key,
      ipa: File.expand_path("../../build/ios/ipa/Snippet.ipa", __dir__),
      app_version: new_version,
      metadata_path: meta_path,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      submit_for_review: false,  # true로 바꾸면 자동 심사 제출
      force: true                # HTML 프리뷰 확인 생략 (non-interactive 환경)
    )

    puts "✅ v#{new_version}+#{new_build} App Store 업로드 완료! App Store Connect에서 심사 제출하세요."
  end

  # ---------------------------------------------------------
  # 빌드 번호 자동 증가 후 TestFlight 배포
  # 사용법: cd app/ios && fastlane ship
  # ---------------------------------------------------------
  desc "버전 bump 후 TestFlight 배포"
  lane :ship do
    # pubspec.yaml에서 현재 버전/빌드 번호 읽기
    pubspec = File.read("../../pubspec.yaml")
    version_line = pubspec.match(/^version:\s*(.+)$/)&.[](1)&.strip
    version_name, build_number = version_line&.split("+")
    new_build = (build_number.to_i + 1).to_s

    # pubspec.yaml 빌드 번호 증가
    new_pubspec = pubspec.gsub(
      /^version:\s*.+$/,
      "version: #{version_name}+#{new_build}"
    )
    File.write("../../pubspec.yaml", new_pubspec)

    puts "📦 버전: #{version_name}+#{new_build}"

    # Flutter 빌드
    Dir.chdir("../..") do
      sh("export PATH=\"/opt/homebrew/bin:$PATH\" && flutter build ipa --release --build-number=#{new_build}")
    end

    # TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path("../../build/ios/ipa/Snippet.ipa", __dir__),
      skip_waiting_for_build_processing: true
    )

    puts "✅ v#{version_name}+#{new_build} TestFlight 업로드 완료!"
  end

  # ---------------------------------------------------------
  # 프로모션 텍스트만 업데이트 (빌드/심사 없이 즉시 반영)
  # 수정 파일: app/ios/fastlane/metadata/ko/promotional_text.txt
  # 사용법: cd app/ios && fastlane promo
  # ---------------------------------------------------------
  desc "프로모션 텍스트 업데이트"
  lane :promo do
    promo_path = File.expand_path("metadata/ko/promotional_text.txt", __dir__)
    UI.user_error!("promotional_text.txt가 없습니다.") unless File.exist?(promo_path)
    UI.user_error!("promotional_text.txt가 비어있습니다.") if File.read(promo_path).strip.empty?

    upload_to_app_store(
      api_key: api_key,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )

    puts "✅ 프로모션 텍스트 업데이트 완료!"
  end

end
