# Naver Clova OCR API
# https://www.ncloud.com/product/aiService/ocr 에서 발급
NAVER_CLOVA_API_URL=https://your-api-url.apigw.ntruss.com/custom/v1/xxxxx/general
NAVER_CLOVA_SECRET_KEY=your_secret_key_here

# Google Cloud Vision API
# https://cloud.google.com/vision/docs/setup 에서 발급
# 방법 1: API 키 사용 (간단)
GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here

# 방법 2: 서비스 계정 사용 (더 안전, 권장)
# Google Cloud Console에서 서비스 계정 생성 후 JSON 다운로드
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=your-project-xxxxx-xxxxxx.json
